# Postgres
DATABASE_URL=postgres://vpn:vpn@localhost:5432/vpn

# Admin login for the dashboard
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me
# Random 32+ char string; signs admin sessions and device tokens
AUTH_SECRET=replace-with-long-random-string

# Protects GET /api/cron/health (send as Authorization: Bearer <CRON_SECRET>)
CRON_SECRET=replace-with-random-string
